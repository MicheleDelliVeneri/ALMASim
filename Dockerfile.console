# The web console (`almasim serve`, API v2) for docker compose on a laptop:
# almasim with the web extra and casatools/casatasks, at the versions in
# uv.lock. Without Slurm, the compose profile (examples/site-profiles/
# laptop.toml) runs every command in this container with the server
# executor. On a cluster, install the wheel instead (docs/console.md).
FROM --platform=linux/amd64 python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock README.md hatch_build.py /app/
COPY src/ /app/src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra web --extra casa

ENV PATH="/app/.venv/bin:$PATH"
RUN mkdir -p /app/outputs /app/data /app/runs \
    && python -c "import almasim.web.app; print('almasim console installed')"

EXPOSE 8765
CMD ["almasim", "serve", "--port", "8765"]
