FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps for building Python scientific packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ tini \
    && rm -rf /var/lib/apt/lists/*

# ALMASim's runtime dependencies (with the dashboard extra) at the versions in
# uv.lock: dask/distributed on the workers must match the client. The project
# itself is not installed; the client uploads its source to the workers.
COPY pyproject.toml uv.lock README.md /tmp/almasim/
COPY backend/pyproject.toml /tmp/almasim/backend/
RUN cd /tmp/almasim \
    && uv export --quiet --frozen --no-dev --no-emit-project --no-hashes --package almasim \
        --extra dashboard --output-file requirements.txt \
    && uv pip install --system --no-cache -r requirements.txt \
    && rm -rf /tmp/almasim

# tini as PID-1 for proper signal handling
ENTRYPOINT ["tini", "-g", "--"]
