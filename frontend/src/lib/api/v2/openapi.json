  "info": {
    "title": "ALMASim web console",
    "version": "2.1.16"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/cluster": {
      "get": {
        "description": "Partitions with their CPU load, the profile's defaults and limits, and your queue.",
        "operationId": "cluster_api_v2_cluster_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Cluster Api V2 Cluster Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cluster",
        "tags": [
          "cluster"
        ]
      }
    },
    "/api/v2/commands": {
      "get": {
        "description": "Every command the console can run, with its parameters and where it runs.",
        "operationId": "list_commands_api_v2_commands_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Commands Api V2 Commands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Commands",
        "tags": [
          "commands"
        ]
      }
    },
    "/api/v2/commands/validate": {
      "post": {
        "description": "What the CLI's parser says about ``argv``, and what would be submitted.",
        "operationId": "validate_command_api_v2_commands_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandLine"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Validate Command Api V2 Commands Validate Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate Command",
        "tags": [
          "commands"
        ]
      }
    },
    "/api/v2/events": {
      "get": {
        "description": "Server-sent events: a snapshot of the runs, then each change.",
        "operationId": "events_api_v2_events_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Events",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v2/files/csv": {
      "get": {
        "description": "A page of rows, with the header; ``total`` counts the data rows.",
        "operationId": "read_csv_api_v2_files_csv_get",
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "title": "Path",
              "type": "string"
            }
          },
          {
            "description": "First data row to return.",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "default": 0,
              "description": "First data row to return.",
              "minimum": 0,
              "title": "Start",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "rows",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 5000,
              "minimum": 1,
              "title": "Rows",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Read Csv Api V2 Files Csv Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Csv",
        "tags": [
          "files"
        ]
      }
    },
